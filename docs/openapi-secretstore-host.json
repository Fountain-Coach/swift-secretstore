{
  "openapi": "3.1.0",
  "info": {
    "title": "SecretStore protected Host custody interface",
    "version": "0.1.0",
    "summary": "Custody use and old-to-new authority continuity at the existing FCIS Host boundary.",
    "description": "Source-owned contract for optional HTTP projection of an independently admitted native Host adapter. It is NOT a standalone SecretStore service, a remote SecretStoreMCP endpoint, a deployed route, or a second authorization authority. SecretStore remains an in-process custody library. Routes, if needed, must first be admitted through the existing FCIS/Host and reflected in the canonical FCIS root OpenAPI. No secret bytes are modeled in any operation."
  },
  "x-fcis-owner-repository": "Fountain-Coach/swift-secretstore",
  "x-fcis-runtime-state": "specified-only-not-deployed",
  "x-fcis-private-host-only": true,
  "tags": [
    {
      "name": "Protected Host custody",
      "description": "Authenticated and independently authorized Host adapter only; not a model/browser/MCP tool inventory."
    }
  ],
  "paths": {
    "/custody/v1/status": {
      "get": {
        "operationId": "inspectSecretCustody",
        "summary": "Inspect redacted SecretStore readiness",
        "description": "A separately admitted Host read may report provider class and readiness. Do not enumerate keys, reveal paths or infer root signing ownership from readiness.",
        "tags": [
          "Protected Host custody"
        ],
        "x-fcis-implementation-state": "specified-only-not-deployed",
        "security": [
          {
            "hostAdmission": []
          }
        ],
        "responses": {
          "200": {
            "description": "Typed redacted response. HTTP success alone is never Store terminal acceptance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyStatus"
                }
              }
            }
          },
          "401": {
            "description": "Host identity/authentication absent or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "403": {
            "description": "Exact Host admission, grant or owner approval refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "409": {
            "description": "Durable replay fence, request binding, or custody conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "410": {
            "description": "Owner approval, operation or lease expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "503": {
            "description": "Host/custody unavailable; no fallback or substitute owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          }
        }
      }
    },
    "/custody/v1/operations": {
      "post": {
        "operationId": "executeBoundCustodyOperation",
        "summary": "Use one owner-approved secret within an admitted Host operation",
        "description": "Require exact Host/client grant, pre-admitted instrument/version and typed operation; check existing owner signer independently from login, canonical request digest, exact target/scope/reference, expiry and atomic replay fence. Native host adapter resolves the SecretStoreReference into an in-memory one-operation lease and returns only redacted FountainStore evidence. No arbitrary shell, signing oracle, credential bytes or lease handle.",
        "tags": [
          "Protected Host custody"
        ],
        "x-fcis-implementation-state": "specified-only-not-deployed",
        "security": [
          {
            "hostAdmission": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BoundOperationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed redacted response. HTTP success alone is never Store terminal acceptance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Host identity/authentication absent or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "403": {
            "description": "Exact Host admission, grant or owner approval refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "409": {
            "description": "Durable replay fence, request binding, or custody conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "410": {
            "description": "Owner approval, operation or lease expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "503": {
            "description": "Host/custody unavailable; no fallback or substitute owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          }
        }
      }
    },
    "/custody/v1/migrations/transfer": {
      "post": {
        "operationId": "transferSecretCustodyWithinHost",
        "summary": "Maintain or move a bounded custody reference set under Hetzner Host",
        "description": "Re-use existing Hetzner provider when possible. A necessary provider change happens only inside the approved Host with provider-supported sealed transfer; never export secret values via HTTP/MCP/Store/chat. Non-exportable key or missing signer must be quarantined. Do not create new owner identities, workstation dependencies or substitute approval UX.",
        "tags": [
          "Protected Host custody"
        ],
        "x-fcis-implementation-state": "specified-only-not-deployed",
        "security": [
          {
            "hostAdmission": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MigrationTransferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed redacted response. HTTP success alone is never Store terminal acceptance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MigrationReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Host identity/authentication absent or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "403": {
            "description": "Exact Host admission, grant or owner approval refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "409": {
            "description": "Durable replay fence, request binding, or custody conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "410": {
            "description": "Owner approval, operation or lease expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "503": {
            "description": "Host/custody unavailable; no fallback or substitute owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          }
        }
      }
    },
    "/custody/v1/migrations/verify": {
      "post": {
        "operationId": "verifySecretCustodyContinuity",
        "summary": "Verify old and new SecretStore continuity without revealing keys",
        "description": "Match old/new FountainStore checkpoints, opaque references, trust-set public fingerprints, revocation/lease status and approved fixed-domain signing challenge. Quarantine unverifiable records. Verification does not activate a new issuer, reauthorize a grant or release the Go service.",
        "tags": [
          "Protected Host custody"
        ],
        "x-fcis-implementation-state": "specified-only-not-deployed",
        "security": [
          {
            "hostAdmission": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MigrationVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed redacted response. HTTP success alone is never Store terminal acceptance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MigrationReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Host identity/authentication absent or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "403": {
            "description": "Exact Host admission, grant or owner approval refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "409": {
            "description": "Durable replay fence, request binding, or custody conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "410": {
            "description": "Owner approval, operation or lease expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          },
          "503": {
            "description": "Host/custody unavailable; no fallback or substitute owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "hostAdmission": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Pre-existing, audience-bound FCIS Host authorization only. Independently verify signed enrolled Host identity, exact instrument grant, permission and resource at execution; owner approval separately required on all mutation paths. Bearer, SSH root or WebAuthn login alone is insufficient."
      }
    },
    "schemas": {
      "CustodyStatus": {
        "type": "object",
        "additionalProperties": false,
        "description": "Read-only Host status without secret names, key enumeration, private material, paths or backend config.",
        "properties": {
          "custodianId": {
            "type": "string",
            "description": "Stable opaque provider identity; never a storage path.",
            "minLength": 1
          },
          "hostId": {
            "type": "string",
            "description": "Currently admitted Host identity.",
            "minLength": 1
          },
          "providerClass": {
            "type": "string",
            "description": "Redacted provider class.",
            "enum": [
              "encrypted-file",
              "secret-service",
              "keychain",
              "external-custodian"
            ]
          },
          "readiness": {
            "type": "string",
            "description": "Observed provider readiness; does not prove signing authority.",
            "enum": [
              "ready",
              "unavailable",
              "unverified"
            ]
          },
          "observedAt": {
            "type": "string",
            "description": "Time of provider observation.",
            "format": "date-time"
          }
        },
        "required": [
          "custodianId",
          "hostId",
          "providerClass",
          "readiness",
          "observedAt"
        ]
      },
      "OwnerApproval": {
        "type": "object",
        "additionalProperties": false,
        "description": "Requires independent Host verification against the existing owner trust root and signed request, with durable expiry/replay checking. WebAuthn login is not a root signing proof.",
        "properties": {
          "approvalId": {
            "type": "string",
            "description": "Existing owner/Golden Key approval identity.",
            "minLength": 8
          },
          "ownerSubject": {
            "type": "string",
            "description": "Existing stable owner subject, not a display name.",
            "minLength": 1
          },
          "signerFingerprint": {
            "type": "string",
            "description": "Existing enrolled owner signing-key fingerprint, verifiable against current trust set.",
            "minLength": 16
          },
          "requestDigest": {
            "type": "string",
            "description": "SHA-256 digest of canonical exact Host, target, instrument, operation, scope, reference set, nonce and expiry.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signedDecision": {
            "type": "string",
            "description": "Signed opaque decision envelope from existing owner authority; never a passkey cookie or private key.",
            "minLength": 32
          },
          "expiresAt": {
            "type": "string",
            "description": "Decision expiry.",
            "format": "date-time"
          }
        },
        "required": [
          "approvalId",
          "ownerSubject",
          "signerFingerprint",
          "requestDigest",
          "signedDecision",
          "expiresAt"
        ]
      },
      "BoundOperationRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Invoke only an already-admitted native Host adapter closure; no secrets, leases or arbitrary shell commands cross HTTP.",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Opaque request/evidence correlation ID.",
            "minLength": 8,
            "maxLength": 128
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Uniquely replay-fenced owner/operation key persisted across restarts.",
            "minLength": 16,
            "maxLength": 128
          },
          "nonce": {
            "type": "string",
            "description": "Single-use request nonce consumed atomically before credential use.",
            "minLength": 16,
            "maxLength": 128
          },
          "expiresAt": {
            "type": "string",
            "description": "Absolute expiry; expired requests fail closed.",
            "format": "date-time"
          },
          "approval": {
            "$ref": "#/components/schemas/OwnerApproval"
          },
          "hostId": {
            "type": "string",
            "description": "Exact enrolled Host (initially Hetzner); no arbitrary URL routing.",
            "minLength": 1
          },
          "instrumentId": {
            "type": "string",
            "description": "Existing admitted typed instrument identity.",
            "minLength": 1
          },
          "instrumentVersion": {
            "type": "string",
            "description": "Exact admitted instrument version.",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "description": "Pre-admitted bounded operation; must match instrument registry exactly.",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "description": "Exact approved target, not a connection address supplied by caller.",
            "minLength": 1,
            "maxLength": 512
          },
          "scope": {
            "type": "string",
            "description": "Exact approved scope.",
            "minLength": 1,
            "maxLength": 256
          },
          "secretReference": {
            "type": "string",
            "description": "Opaque SecretStoreReference, not a file path or secret value.",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "correlationId",
          "idempotencyKey",
          "nonce",
          "expiresAt",
          "approval",
          "hostId",
          "instrumentId",
          "instrumentVersion",
          "operation",
          "target",
          "scope",
          "secretReference"
        ]
      },
      "CustodyReceipt": {
        "type": "object",
        "additionalProperties": false,
        "description": "No credential, ciphertext, signature oracle, lease or raw provider error is returned.",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Opaque request/evidence correlation ID.",
            "minLength": 8,
            "maxLength": 128
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Uniquely replay-fenced owner/operation key persisted across restarts.",
            "minLength": 16,
            "maxLength": 128
          },
          "operation": {
            "type": "string",
            "description": "Admitted attempted operation."
          },
          "state": {
            "type": "string",
            "description": "Terminal operation outcome.",
            "enum": [
              "succeeded",
              "refused",
              "failed",
              "unverified"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Non-sensitive terminal result.",
            "enum": [
              "none",
              "authorization_required",
              "approval_denied",
              "approval_expired",
              "replayed",
              "wrong_host",
              "wrong_scope",
              "wrong_target",
              "credential_unavailable",
              "provider_unavailable",
              "non_exportable",
              "integrity_failed",
              "unverified",
              "internal_failure"
            ]
          },
          "providerClass": {
            "type": "string",
            "description": "Redacted provider class.",
            "enum": [
              "encrypted-file",
              "secret-service",
              "keychain",
              "external-custodian"
            ]
          },
          "evidenceRef": {
            "type": "string",
            "description": "Optional opaque independently read-back FountainStore terminal receipt ID.",
            "minLength": 1
          },
          "observedAt": {
            "type": "string",
            "description": "Terminal observation time.",
            "format": "date-time"
          }
        },
        "required": [
          "correlationId",
          "idempotencyKey",
          "operation",
          "state",
          "reason",
          "observedAt"
        ]
      },
      "MigrationTransferRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Hetzner-started, Host-internal source/destination continuity. Never include secret payloads in HTTP or ordinary Store. Nonexportable credentials are quarantined, not recreated.",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Opaque request/evidence correlation ID.",
            "minLength": 8,
            "maxLength": 128
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Uniquely replay-fenced owner/operation key persisted across restarts.",
            "minLength": 16,
            "maxLength": 128
          },
          "nonce": {
            "type": "string",
            "description": "Single-use request nonce consumed atomically before credential use.",
            "minLength": 16,
            "maxLength": 128
          },
          "expiresAt": {
            "type": "string",
            "description": "Absolute expiry; expired requests fail closed.",
            "format": "date-time"
          },
          "approval": {
            "$ref": "#/components/schemas/OwnerApproval"
          },
          "hostId": {
            "type": "string",
            "description": "The enrolled headless Hetzner coordinator Host.",
            "minLength": 1
          },
          "sourceCustodianId": {
            "type": "string",
            "description": "Observed existing custodian; not path or SSH target.",
            "minLength": 1
          },
          "destinationCustodianId": {
            "type": "string",
            "description": "Observed new custody ID (may equal existing custody when reused).",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "description": "Reuse existing custody by default. Sealed provider transition only when actually required, supported and approved.",
            "enum": [
              "reuse-existing-custody",
              "provider-sealed-transfer"
            ]
          },
          "secretReferences": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Opaque SecretStoreReference, not a file path or secret value.",
              "minLength": 1,
              "maxLength": 256
            },
            "description": "Explicit approved reference set: no all-secrets wildcard.",
            "maxItems": 100
          },
          "sourceStoreWatermark": {
            "type": "string",
            "description": "Verified old FountainStore checkpoint ID.",
            "minLength": 1
          },
          "destinationStoreWatermark": {
            "type": "string",
            "description": "Verified new FountainStore checkpoint ID.",
            "minLength": 1
          },
          "expectedIssuer": {
            "type": "string",
            "description": "Existing issuer must not change.",
            "const": "https://fcis.fountain.coach/"
          }
        },
        "required": [
          "correlationId",
          "idempotencyKey",
          "nonce",
          "expiresAt",
          "approval",
          "hostId",
          "sourceCustodianId",
          "destinationCustodianId",
          "mode",
          "secretReferences",
          "sourceStoreWatermark",
          "destinationStoreWatermark",
          "expectedIssuer"
        ]
      },
      "MigrationVerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Verify new custody matches old without a general signing oracle; fixed challenge requires domain separation, key fingerprint and approval.",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Opaque request/evidence correlation ID.",
            "minLength": 8,
            "maxLength": 128
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Uniquely replay-fenced owner/operation key persisted across restarts.",
            "minLength": 16,
            "maxLength": 128
          },
          "nonce": {
            "type": "string",
            "description": "Single-use request nonce consumed atomically before credential use.",
            "minLength": 16,
            "maxLength": 128
          },
          "expiresAt": {
            "type": "string",
            "description": "Absolute expiry; expired requests fail closed.",
            "format": "date-time"
          },
          "approval": {
            "$ref": "#/components/schemas/OwnerApproval"
          },
          "hostId": {
            "type": "string",
            "description": "Exact admitted coordinator Host.",
            "minLength": 1
          },
          "sourceCustodianId": {
            "type": "string",
            "description": "Verified source custody identity.",
            "minLength": 1
          },
          "destinationCustodianId": {
            "type": "string",
            "description": "Verified destination custody identity.",
            "minLength": 1
          },
          "sourceStoreWatermark": {
            "type": "string",
            "description": "Verified old FountainStore checkpoint ID.",
            "minLength": 1
          },
          "destinationStoreWatermark": {
            "type": "string",
            "description": "Verified new FountainStore checkpoint ID.",
            "minLength": 1
          },
          "secretReferences": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Opaque SecretStoreReference, not a file path or secret value.",
              "minLength": 1,
              "maxLength": 256
            },
            "description": "Exact approved references, no enumeration.",
            "maxItems": 100
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Exact approved continuity check.",
              "enum": [
                "reference-resolution",
                "domain-separated-signing-challenge",
                "revocation-and-lease-fence"
              ]
            },
            "description": "Required Host checks.",
            "maxItems": 3
          }
        },
        "required": [
          "correlationId",
          "idempotencyKey",
          "nonce",
          "expiresAt",
          "approval",
          "hostId",
          "sourceCustodianId",
          "destinationCustodianId",
          "sourceStoreWatermark",
          "destinationStoreWatermark",
          "secretReferences",
          "checks"
        ]
      },
      "MigrationReferenceResult": {
        "type": "object",
        "additionalProperties": false,
        "description": "Per-reference result; no credential-value fields.",
        "properties": {
          "secretReference": {
            "type": "string",
            "description": "Opaque SecretStoreReference, not a file path or secret value.",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "type": "string",
            "description": "Per-reference disposition.",
            "enum": [
              "preserved",
              "quarantined",
              "unverified"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Redacted reason.",
            "enum": [
              "none",
              "non_exportable",
              "missing",
              "wrong_signer",
              "expired",
              "revoked",
              "challenge_failed",
              "provider_unavailable",
              "unverified"
            ]
          },
          "publicKeyFingerprint": {
            "type": "string",
            "description": "Optional public signing-key fingerprint, not private key.",
            "minLength": 16
          }
        },
        "required": [
          "secretReference",
          "state",
          "reason"
        ]
      },
      "MigrationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "description": "Migration proof, not authorization/activation.",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Opaque request/evidence correlation ID.",
            "minLength": 8,
            "maxLength": 128
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Uniquely replay-fenced owner/operation key persisted across restarts.",
            "minLength": 16,
            "maxLength": 128
          },
          "state": {
            "type": "string",
            "description": "Migration/verification result; never activates an issuer.",
            "enum": [
              "verified",
              "refused",
              "quarantined",
              "unverified"
            ]
          },
          "sourceCustodianId": {
            "type": "string",
            "description": "Source provider identity."
          },
          "destinationCustodianId": {
            "type": "string",
            "description": "Destination provider identity."
          },
          "sourceStoreWatermark": {
            "type": "string",
            "description": "Compared source snapshot checkpoint."
          },
          "destinationStoreWatermark": {
            "type": "string",
            "description": "Compared destination checkpoint."
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MigrationReferenceResult"
            },
            "description": "One redacted disposition per approved reference.",
            "maxItems": 100
          },
          "fountainStoreReceiptRef": {
            "type": "string",
            "description": "Optional independent FountainStore evidence identity.",
            "minLength": 1
          },
          "observedAt": {
            "type": "string",
            "description": "Observation time.",
            "format": "date-time"
          }
        },
        "required": [
          "correlationId",
          "idempotencyKey",
          "state",
          "sourceCustodianId",
          "destinationCustodianId",
          "sourceStoreWatermark",
          "destinationStoreWatermark",
          "results",
          "observedAt"
        ]
      },
      "CustodyError": {
        "type": "object",
        "additionalProperties": false,
        "description": "No raw provider error, reference contents or secret metadata.",
        "properties": {
          "error": {
            "type": "string",
            "description": "Typed, redacted refusal: no existence oracle.",
            "enum": [
              "unauthorized_host",
              "approval_required",
              "scope_denied",
              "approval_expired",
              "replay_detected",
              "reference_invalid",
              "provider_unavailable",
              "non_exportable",
              "custody_unverified",
              "integrity_failed"
            ]
          },
          "correlationId": {
            "type": "string",
            "description": "Optional request correlation identity."
          },
          "terminal": {
            "type": "boolean",
            "const": true,
            "description": "Refusal is terminal for this request."
          }
        },
        "required": [
          "error",
          "terminal"
        ]
      }
    }
  }
}
